<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Bipolar Media" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header>
      <nav>
        <%= link_to "Bipolar Media", root_path %> |
        <%= link_to "Статьи", articles_path %> |
        <%= link_to "Тесты", screening_tests_path %> |
        <%= link_to "Специалисты", specialists_path %>
        <% if user_signed_in? %>
          | <%= link_to "Трекер настроения", mood_entries_path %>
          | <%= button_to "Выйти", destroy_user_session_path, method: :delete, form: { style: "display:inline" } %>
        <% else %>
          | <%= link_to "Войти", new_user_session_path %>
          | <%= link_to "Регистрация", new_user_registration_path %>
        <% end %>
      </nav>
    </header>

    <main>
      <p><%= notice %></p>
      <p><%= alert %></p>
      <%= yield %>
    </main>
  </body>
</html>
