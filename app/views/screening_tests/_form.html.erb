<%= form_with model: screening_test do |f| %>
  <% if screening_test.errors.any? %>
    <div role="alert"><ul><% screening_test.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul></div>
  <% end %>
  <p><%= f.label :title, "Название" %><br><%= f.text_field :title, required: true %></p>
  <p><%= f.label :description, "Описание" %><br><%= f.text_area :description, rows: 5 %></p>
  <p><%= f.label :kind, "Тип теста" %><br><%= f.select :kind, [["Скрининг", "screening"], ["Самопроверка", "self_check"]], include_blank: "Выберите тип", required: true %></p>
  <p><%= f.submit "Сохранить" %></p>
<% end %>
