<h1>Скрининговые тесты</h1>

<% if user_signed_in? && current_user.access_role_admin? %>
  <p><%= link_to "← Администрирование", admin_root_path %></p>
<% end %>
<% if can?(:create, ScreeningTest) %><p><%= link_to "Создать тест", new_screening_test_path %></p><% end %>

<%= form_with url: screening_tests_path, method: :get, scope: nil do %>
  <p>
    <%= label_tag :q, "Поиск по названию и описанию" %><br>
    <%= text_field_tag :q, params[:q], id: "screening-test-search" %>
  </p>
  <p>
    <%= label_tag :kind, "Тип теста" %><br>
    <%= select_tag :kind,
          options_for_select([["Скрининг", "screening"], ["Самопроверка", "self_check"]], params[:kind]),
          include_blank: "Все типы" %>
  </p>
  <%= submit_tag "Найти" %>
  <%= link_to "Сбросить", screening_tests_path %>
<% end %>

<% if @screening_tests.any? %>
  <table>
    <thead>
      <tr>
        <th scope="col">Название</th>
        <th scope="col">Описание</th>
        <th scope="col">Тип</th>
        <th scope="col">Действия</th>
      </tr>
    </thead>
    <tbody>
      <% @screening_tests.each do |test| %>
        <tr>
          <td><%= link_to test.title, test %></td>
          <td><%= test.description %></td>
          <td><%= test.kind %></td>
          <td>
            <% if can?(:update, test) %><%= link_to "Редактировать", edit_screening_test_path(test) %><% end %>
            <% if can?(:destroy, test) %>
              <%= button_to "Удалить", test, method: :delete,
                    form: { data: { turbo_confirm: "Удалить тест «#{test.title}»?" } } %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>По заданным условиям тесты не найдены.</p>
<% end %>

<%= render "shared/pagination" %>
