<% content_for :title, "Администрирование | Bipolar Media" %>

<h1>Панель администратора</h1>
<p>Управление материалами Bipolar Media.</p>

<p>
  <%= link_to "Открыть сайт", root_path %> |
  <%= link_to "Все статьи", articles_path %> |
  <%= link_to "Все тесты", screening_tests_path %> |
  <%= link_to "Все специалисты", specialists_path %>
</p>

<h2>Обзор контента</h2>
<table>
  <thead>
    <tr>
      <th scope="col">Раздел</th>
      <th scope="col">Всего записей</th>
      <th scope="col">Действия</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <th scope="row">Статьи</th>
      <td><%= @articles_count %></td>
      <td>
        <%= link_to "Управлять статьями", articles_path %> |
        <%= link_to "Создать статью", new_article_path %>
      </td>
    </tr>
    <tr>
      <th scope="row">Скрининговые тесты</th>
      <td><%= @screening_tests_count %></td>
      <td>
        <%= link_to "Управлять тестами", screening_tests_path %> |
        <%= link_to "Создать тест", new_screening_test_path %>
      </td>
    </tr>
    <tr>
      <th scope="row">Специалисты</th>
      <td><%= @specialists_count %></td>
      <td>
        <%= link_to "Управлять специалистами", specialists_path %> |
        <%= link_to "Добавить специалиста", new_specialist_path %>
      </td>
    </tr>
  </tbody>
</table>

<h2>Последние статьи</h2>
<% if @articles.any? %>
  <table>
    <thead>
      <tr>
        <th scope="col">Название</th>
        <th scope="col">Тип</th>
        <th scope="col">Аудитория</th>
        <th scope="col">Дата создания</th>
        <th scope="col">Действия</th>
      </tr>
    </thead>
    <tbody>
      <% @articles.each do |article| %>
        <tr>
          <td><%= article.title %></td>
          <td><%= article.content_kind %></td>
          <td><%= article.audience %></td>
          <td><%= l(article.created_at, format: :short) %></td>
          <td>
            <%= link_to "Открыть", article_path(article) %> |
            <%= link_to "Редактировать", edit_article_path(article) %> |
            <%= button_to "Удалить", article_path(article), method: :delete,
                  form: { data: { turbo_confirm: "Удалить статью «#{article.title}»?" } } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>Статей пока нет.</p>
<% end %>
<p><%= link_to "Создать статью", new_article_path %></p>

<h2>Последние скрининговые тесты</h2>
<% if @screening_tests.any? %>
  <table>
    <thead>
      <tr>
        <th scope="col">Название</th>
        <th scope="col">Тип</th>
        <th scope="col">Дата создания</th>
        <th scope="col">Действия</th>
      </tr>
    </thead>
    <tbody>
      <% @screening_tests.each do |screening_test| %>
        <tr>
          <td><%= screening_test.title %></td>
          <td><%= screening_test.kind %></td>
          <td><%= l(screening_test.created_at, format: :short) %></td>
          <td>
            <%= link_to "Открыть", screening_test_path(screening_test) %> |
            <%= link_to "Редактировать", edit_screening_test_path(screening_test) %> |
            <%= button_to "Удалить", screening_test_path(screening_test), method: :delete,
                  form: { data: { turbo_confirm: "Удалить тест «#{screening_test.title}»?" } } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>Тестов пока нет.</p>
<% end %>
<p><%= link_to "Создать тест", new_screening_test_path %></p>

<h2>Последние специалисты</h2>
<% if @specialists.any? %>
  <table>
    <thead>
      <tr>
        <th scope="col">ФИО</th>
        <th scope="col">Специализация</th>
        <th scope="col">Город</th>
        <th scope="col">Действия</th>
      </tr>
    </thead>
    <tbody>
      <% @specialists.each do |specialist| %>
        <tr>
          <td><%= specialist.full_name %></td>
          <td><%= specialist.specialty %></td>
          <td><%= specialist.city.name %></td>
          <td>
            <%= link_to "Открыть", specialist_path(specialist) %> |
            <%= link_to "Редактировать", edit_specialist_path(specialist) %> |
            <%= button_to "Удалить", specialist_path(specialist), method: :delete,
                  form: { data: { turbo_confirm: "Удалить специалиста «#{specialist.full_name}»?" } } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>Специалистов пока нет.</p>
<% end %>
<p><%= link_to "Добавить специалиста", new_specialist_path %></p>
