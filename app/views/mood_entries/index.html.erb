<h1>Трекер настроения</h1>
<p><%= link_to "Новая запись", new_mood_entry_path %></p>
<table>
  <thead><tr><th>Дата</th><th>Настроение</th><th>Энергия</th><th>Сон, ч</th><th>Заметка</th><th>Действия</th></tr></thead>
  <tbody>
    <% @mood_entries.each do |m| %>
      <tr>
        <td><%= link_to l(m.entry_date), mood_entry_path(m) %></td>
        <td><%= m.mood_level %></td><td><%= m.energy_level %></td><td><%= m.sleep_hours %></td><td><%= m.note %></td>
        <td><%= link_to "Изменить", edit_mood_entry_path(m) %> <%= button_to "Удалить", mood_entry_path(m), method: :delete, form: { data: { turbo_confirm: "Удалить запись?" } } %></td>
      </tr>
    <% end %>
  </tbody>
</table>
