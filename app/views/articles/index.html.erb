<h1>Статьи</h1>
<% if can?(:create, Article) %><p><%= link_to "Создать статью", new_article_path %></p><% end %>
<p>
  Фильтр:
  <%= link_to "Все", articles_path %> |
  <%= link_to "Мне (диагноз)", articles_path(audience: "patient") %> |
  <%= link_to "Близким", articles_path(audience: "relative") %>
</p>
<% @articles.each do |article| %>
  <article>
    <h2><%= link_to article.title, article %></h2>
    <p><%= article.summary %></p>
    <p><small><%= article.content_kind %> · <%= article.tags.map(&:name).join(", ") %></small></p>
    <% if can?(:update, article) %><%= link_to "Редактировать", edit_article_path(article) %><% end %>
    <% if can?(:destroy, article) %><%= button_to "Удалить", article, method: :delete, form: { data: { turbo_confirm: "Удалить статью?" } } %><% end %>
  </article>
<% end %>
