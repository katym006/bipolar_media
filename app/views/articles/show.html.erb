<h1><%= @article.title %></h1>
<p><small><%= @article.tags.map(&:name).join(", ") %></small></p>
<%= simple_format(@article.body) %>
<% if can?(:update, @article) %><p><%= link_to "Редактировать", edit_article_path(@article) %></p><% end %>
<% if can?(:destroy, @article) %><%= button_to "Удалить", @article, method: :delete, form: { data: { turbo_confirm: "Удалить статью?" } } %><% end %>
<p><%= link_to "← Все статьи", articles_path %></p>
