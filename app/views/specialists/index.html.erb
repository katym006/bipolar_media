<h1>Специалисты</h1>

<% if user_signed_in? && current_user.access_role_admin? %>
  <p><%= link_to "← Администрирование", admin_root_path %></p>
<% end %>
<% if can?(:create, Specialist) %><p><%= link_to "Добавить специалиста", new_specialist_path %></p><% end %>

<%= form_with url: specialists_path, method: :get, scope: nil do %>
  <p>
    <%= label_tag :q, "Поиск по ФИО, специализации и контактам" %><br>
    <%= text_field_tag :q, params[:q], id: "specialist-search" %>
  </p>
  <p>
    <%= label_tag :city_id, "Город" %><br>
    <%= select_tag :city_id,
          options_from_collection_for_select(@cities, :id, :name, params[:city_id]),
          include_blank: "Все города" %>
  </p>
  <%= submit_tag "Найти" %>
  <%= link_to "Сбросить", specialists_path %>
<% end %>

<% if @specialists.any? %>
  <table>
    <thead>
      <tr>
        <th scope="col">ФИО</th>
        <th scope="col">Специализация</th>
        <th scope="col">Город</th>
        <th scope="col">Контакты</th>
        <th scope="col">Рейтинг</th>
        <th scope="col">Действия</th>
      </tr>
    </thead>
    <tbody>
      <% @specialists.each do |specialist| %>
        <tr>
          <td><%= link_to specialist.full_name, specialist_path(specialist) %></td>
          <td><%= specialist.specialty %></td>
          <td><%= specialist.city.name %></td>
          <td><%= specialist.contacts %></td>
          <td><%= specialist.rating %></td>
          <td>
            <% if can?(:update, specialist) %><%= link_to "Редактировать", edit_specialist_path(specialist) %><% end %>
            <% if can?(:destroy, specialist) %>
              <%= button_to "Удалить", specialist_path(specialist), method: :delete,
                    form: { data: { turbo_confirm: "Удалить специалиста «#{specialist.full_name}»?" } } %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>По заданным условиям специалисты не найдены.</p>
<% end %>

<%= render "shared/pagination" %>
